{
  "permissions": {
    "allow": [
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npm run *)",
      "Bash(npx vite *)",
      "Bash(npx electron *)",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "Bash(git add *)",
      "Bash(git push *)",
      "Bash(npx electron-builder *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/memory/scripts/memory_agent.py report --oneline",
            "timeout": 10,
            "statusMessage": "Checking memory health..."
          }
        ]
      }
    ]
  },
  "autoDreamEnabled": true
}
