# O.G.R.E OAuth Backend — Environment Variables
# Set these in Vercel Dashboard → Project → Settings → Environment Variables

# Google OAuth (for Gemini sign-in)
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The Chrome extension redirect URI — format: https://<extension-id>.chromiumapp.org/google
# Get extension ID from chrome://extensions after loading with stable key in manifest.json
GOOGLE_REDIRECT_URI=https://your-extension-id.chromiumapp.org/google

# GitHub OAuth (for GitHub Models sign-in)
# Get from: GitHub → Settings → Developer Settings → OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# CORS — Chrome extension origin to allow
# Format: chrome-extension://<extension-id>
ALLOWED_ORIGIN=chrome-extension://your-extension-id
